# All secrets are set in the deployment environment, not in Git.
DATABASE_URL=postgresql://<server-only-pooled-url>
NEON_AUTH_BASE_URL=https://<your-neon-auth-url>
NEON_AUTH_COOKIE_SECRET=<generated-32+-character-secret>
# Real finance data stays disabled until G1/G2 accepted.
FINANCE_WRITES_ENABLED=false
